# HYPER MES - Sage Pastel Bridge Configuration
# Copy this file to .env and update with your actual values

# Supabase Configuration
SUPABASE_URL=https://appyuqxetlphuxfybmus.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Sage Pastel Configuration
SAGE_PATH=C:\Pastel\Partner\Partner.exe
SAGE_COMPANY=HYPER FEEDS
SAGE_DATABASE=C:\Pastel\Data\HYPER
SAGE_USERNAME=Manager
SAGE_PASSWORD=

# Bridge Configuration
NODE_ENV=development
POLL_INTERVAL=30000
BATCH_SIZE=10
MAX_RETRIES=3

# Logging
LOG_LEVEL=info
LOG_FILE=logs/bridge.log

# For Production (change these when going live)
# NODE_ENV=production
# SAGE_SERVER=remote-sage-server-ip
# SAGE_DATABASE=\\remote-server\Pastel\Data\HYPER
