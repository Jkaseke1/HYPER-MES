# HYPER MES - Sage Pastel Bridge Configuration
# Copy this file to .env and fill in the real values

# Supabase — use the SERVICE ROLE key (server-side, not anon)
SUPABASE_URL=https://appyuqxetlphuxfybmus.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Sage Pastel — direct MSSQL connection (port 50119 = default Pastel SQL instance)
SAGE_DATABASE=Hyperfeeds 2024
SAGE_USER=sa
SAGE_PASSWORD=

# CRM customer master import classification. Sage remains authoritative for
# account/contact/credit fields; CRM-owned segmentation can be edited later.
# These regexes are only initial classification rules for the first import.
SAGE_CRM_SMALL_SCALE_PATTERN=small[- ]?scale|farmer|grower
SAGE_CRM_DEALER_PATTERN=dealer|agent|distributor

# Bridge behaviour
# Set DRY_RUN=true to log SQL without writing to Sage (safe for testing)
DRY_RUN=true

# Phased rollout safety gate. This deployment enables only GRNs and
# Production material receipts; all other Sage event types remain blocked.
BRIDGE_ALLOWED_EVENT_TYPES=grn_confirmed,material_transfer_to_production
BRIDGE_ENFORCE_SAGE_IDENTITY=true
SAGE_EXPECTED_ENVIRONMENT=UAT
SAGE_EXPECTED_COMPANY_DATABASE=Hyperfeeds 2026 UAT

# Read-only Sage Vendor reconciliation for transporter requests raised at the
# weighbridge. This only updates PlantControl after Finance creates the Sage vendor.
SAGE_TRANSPORTER_SYNC_ENABLED=false
SAGE_TRANSPORTER_SYNC_INTERVAL_MS=900000
